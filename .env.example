# LiA - variabili d'ambiente. Copiare in `.env` (mai versionato) e completare.
# In produzione (Railway) si impostano come variabili del servizio, mai nel repository.
# Senza LIA_OPERATOR_PASSWORD_HASH il sito funziona in sola consultazione.

# --- Accesso operatore ----------------------------------------------------------
# Hash Argon2id della password (mai la password in chiaro). Generarlo con:
#   python -m linkedia hash-password
LIA_OPERATOR_PASSWORD_HASH=
# Cambiare questo valore chiude tutte le sessioni aperte (anche cambiare l'hash le chiude).
# LIA_SESSION_EPOCH=1
# Durata assoluta della sessione in ore (default 8).
# LIA_SESSION_HOURS=8
# Solo sviluppo locale su http://: cookie senza attributo Secure. In produzione lasciare true.
# LIA_COOKIE_SECURE=true
# Proxy fidati davanti all'app: 1 su Railway, 0 in locale.
# LIA_PROXY_HOPS=0
# Host canonico: le richieste a www.<host> vengono reindirizzate qui.
# LIA_CANONICAL_HOST=linked-intelligent-analyst.it

# --- Sintesi IA (servizio a pagamento) -----------------------------------------
# Attiva la sintesi solo insieme a LIA_OPERATOR_PASSWORD_HASH e a un modello con prezzo verificato.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modelli ammessi: deepseek-flash, deepseek-v4-pro (vedi linkedia/services/budget.py).
# DEEPSEEK_MODEL=deepseek-flash
# Numero massimo di sintesi nelle ultime 24 ore (default 20).
# LIA_AI_DAILY_LIMIT=20
# Budget globale delle chiamate a pagamento, in USD, sulla finestra mobile (default 3.00 / 24 ore).
# LIA_API_BUDGET_USD=3.00
# LIA_API_BUDGET_WINDOW_HOURS=24
# Pausa minima dopo un rifiuto per budget, in minuti (default 60).
# LIA_API_BLOCK_MINUTES=60

# --- Ricerca automatica delle notizie (servizio a pagamento) -------------------------
# Perplexity Search API: abilita la ricerca per data (con LIA_OPERATOR_PASSWORD_HASH).
PERPLEXITY_API_KEY=
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# Tetto di costo per singola ricerca, in USD (richieste di ricerca + estrazione IA facoltativa).
# LIA_NEWS_SEARCH_MAX_USD=0.05

# --- Informative --------------------------------------------------------------------
# Dati del titolare mostrati in /privacy e /cookie. Senza valori l'informativa si dichiara incompleta.
# LIA_CONTROLLER_NAME=
# LIA_CONTROLLER_EMAIL=

# --- Dati e percorsi ------------------------------------------------------------------
# Percorsi relativi alla radice del progetto, non alla directory di avvio.
# LIA_DATABASE_PATH=instance/lia.sqlite3
# LIA_FRONTEND_DIST=frontend/dist
# Evento del caso dimostrativo in home page (deve essere pubblico).
# LIA_FEATURED_EVENT=russia-invades-ukraine-2022

# --- Varie ---------------------------------------------------------------------------
# Timeout in secondi per le richieste ai provider prezzi (default 20).
# LIA_HTTP_TIMEOUT=20
# LIA_LOG_LEVEL=INFO
# Solo sviluppo locale: mai attivo su un server raggiungibile da altri.
# LIA_DEBUG=false
