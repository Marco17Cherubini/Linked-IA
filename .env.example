# LiA - variabili d'ambiente. Copiare in `.env` (mai versionato) e completare.
# Tutte le voci sono facoltative: senza chiavi l'applicazione funziona in sola consultazione.

# --- Accesso analista --------------------------------------------------------
# Token richiesto per creare analisi e generare sintesi IA (intestazione Authorization: Bearer).
# Senza valore la creazione è disabilitata. Generarlo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LIA_ADMIN_TOKEN=

# --- Sintesi IA (servizio a pagamento) ---------------------------------------
# Attiva la sintesi testuale solo se impostata insieme a LIA_ADMIN_TOKEN.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# Numero massimo di sintesi nelle ultime 24 ore (default 20).
# LIA_AI_DAILY_LIMIT=20

# --- Dati e percorsi -----------------------------------------------------------
# Percorsi relativi alla radice del progetto, non alla directory di avvio.
# LIA_DATABASE_PATH=instance/lia.sqlite3
# LIA_FRONTEND_DIST=frontend/dist
# Evento del caso dimostrativo in home page.
# LIA_FEATURED_EVENT=russia-invades-ukraine-2022

# --- Varie -------------------------------------------------------------------
# Timeout in secondi per le richieste ai provider esterni (default 20).
# LIA_HTTP_TIMEOUT=20
# LIA_LOG_LEVEL=INFO
# Solo sviluppo locale: mai attivo su un server raggiungibile da altri.
# LIA_DEBUG=false
